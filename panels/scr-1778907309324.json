{
  "screenId": "scr-1778907309324",
  "screenName": "異常値検出処理",
  "html": "<div style=\"display: grid; grid-template-columns: 1fr 320px; gap: 12px; padding: 12px;\">\n  <!-- メインエリア -->\n  <div>\n    <!-- 画面タイトル -->\n    <div style=\"margin-bottom: 12px;\">\n      <h1 style=\"font-size: 16px; font-weight: 600; color: var(--text); margin: 0;\">異常値検出処理</h1>\n    </div>\n\n    <!-- 検出設定・実行エリア -->\n    <div class=\"card\" style=\"margin-bottom: 12px; padding: 14px;\">\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 12px; align-items: end;\">\n        <div>\n          <label style=\"display: block; font-size: 11px; color: var(--text-muted); margin-bottom: 4px;\">検出対象期間（開始）</label>\n          <input type=\"date\" id=\"start-date\" style=\"padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); color: var(--text); font-size: 13px; line-height: 1.4; width: 100%;\">\n        </div>\n        <div>\n          <label style=\"display: block; font-size: 11px; color: var(--text-muted); margin-bottom: 4px;\">検出対象期間（終了）</label>\n          <input type=\"date\" id=\"end-date\" style=\"padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); color: var(--text); font-size: 13px; line-height: 1.4; width: 100%;\">\n        </div>\n        <div>\n          <label style=\"display: block; font-size: 11px; color: var(--text-muted); margin-bottom: 4px;\">検出ルール</label>\n          <select id=\"detection-rule\" style=\"padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); color: var(--text); font-size: 13px; line-height: 1.4; width: 100%;\">\n            <option value=\"all\">全ルール</option>\n            <option value=\"overtime\">長時間作業</option>\n            <option value=\"frequent-break\">頻繁中断</option>\n            <option value=\"over-hours\">工数超過</option>\n            <option value=\"invalid-time\">時刻異常</option>\n          </select>\n        </div>\n        <div>\n          <button id=\"btn-detect\" class=\"action-btn\" style=\"height: 32px; padding: 6px 16px;\">検出実行</button>\n        </div>\n      </div>\n      \n      <!-- 進捗表示 -->\n      <div id=\"progress-area\" class=\"hidden\" style=\"margin-top: 12px; padding: 8px; background: rgba(255,255,255,0.02); border-radius: 4px;\">\n        <div style=\"font-size: 12px; color: var(--text-muted); margin-bottom: 4px;\">検出処理中...</div>\n        <div style=\"background: var(--border); height: 4px; border-radius: 2px; overflow: hidden;\">\n          <div id=\"progress-bar\" style=\"background: var(--primary); height: 100%; width: 0%; transition: width 0.3s;\"></div>\n        </div>\n      </div>\n    </div>\n\n    <!-- フィルター・操作エリア -->\n    <div class=\"card\" style=\"margin-bottom: 12px; padding: 14px;\">\n      <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr auto auto auto; gap: 12px; align-items: end;\">\n        <div>\n          <label style=\"display: block; font-size: 11px; color: var(--text-muted); margin-bottom: 4px;\">異常値種別</label>\n          <select id=\"filter-type\" style=\"padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); color: var(--text); font-size: 13px; line-height: 1.4; width: 100%;\">\n            <option value=\"\">全て</option>\n            <option value=\"長時間作業\">長時間作業</option>\n            <option value=\"頻繁中断\">頻繁中断</option>\n            <option value=\"工数超過\">工数超過</option>\n            <option value=\"時刻異常\">時刻異常</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"display: block; font-size: 11px; color: var(--text-muted); margin-bottom: 4px;\">重要度</label>\n          <select id=\"filter-severity\" style=\"padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); color: var(--text); font-size: 13px; line-height: 1.4; width: 100%;\">\n            <option value=\"\">全て</option>\n            <option value=\"高\">高</option>\n            <option value=\"中\">中</option>\n            <option value=\"低\">低</option>\n          </select>\n        </div>\n        <div>\n          <label style=\"display: block; font-size: 11px; color: var(--text-muted); margin-bottom: 4px;\">確認状況</label>\n          <select id=\"filter-status\" style=\"padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); color: var(--text); font-size: 13px; line-height: 1.4; width: 100%;\">\n            <option value=\"\">全て</option>\n            <option value=\"未確認\">未確認</option>\n            <option value=\"確認済み\">確認済み</option>\n            <option value=\"対応済み\">対応済み</option>\n          </select>\n        </div>\n        <div>\n          <button id=\"btn-filter\" class=\"action-btn secondary\" style=\"height: 32px; padding: 6px 12px;\">フィルター</button>\n        </div>\n        <div>\n          <button id=\"btn-bulk-approve\" class=\"action-btn secondary\" style=\"height: 32px; padding: 6px 12px;\">一括承認</button>\n        </div>\n        <div>\n          <button id=\"btn-export\" class=\"action-btn secondary\" style=\"height: 32px; padding: 6px 12px;\">CSV出力</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- 異常値一覧テーブル -->\n    <div class=\"card\" style=\"padding: 0;\">\n      <div class=\"table-wrap\">\n        <table>\n          <thead>\n            <tr>\n              <th style=\"width: 40px; padding: 8px 10px;\">\n                <input type=\"checkbox\" id=\"select-all\" style=\"accent-color: var(--primary);\">\n              </th>\n              <th style=\"padding: 8px 10px;\">検出日時</th>\n              <th style=\"padding: 8px 10px;\">作業員</th>\n              <th style=\"padding: 8px 10px;\">異常値種別</th>\n              <th style=\"padding: 8px 10px;\">検出項目</th>\n              <th style=\"padding: 8px 10px;\">検出値</th>\n              <th style=\"padding: 8px 10px;\">閾値</th>\n              <th style=\"padding: 8px 10px;\">重要度</th>\n              <th style=\"padding: 8px 10px;\">確認状況</th>\n              <th style=\"padding: 8px 10px;\">操作</th>\n            </tr>\n          </thead>\n          <tbody id=\"anomaly-tbody\">\n          </tbody>\n        </table>\n      </div>\n    </div>\n  </div>\n\n  <!-- サイドパネル -->\n  <div>\n    <!-- 検出ルール設定 -->\n    <div class=\"card\" style=\"margin-bottom: 12px; padding: 14px;\">\n      <h3 style=\"font-size: 13px; font-weight: 600; color: var(--text); margin: 0 0 10px 0;\">検出ルール設定</h3>\n      \n      <div style=\"margin-bottom: 10px;\">\n        <label style=\"display: block; font-size: 11px; color: var(--text-muted); margin-bottom: 4px;\">長時間作業閾値（時間）</label>\n        <input type=\"number\" id=\"overtime-threshold\" value=\"10\" min=\"1\" max=\"24\" style=\"padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); color: var(--text); font-size: 13px; line-height: 1.4; width: 100%;\">\n      </div>\n      \n      <div style=\"margin-bottom: 10px;\">\n        <label style=\"display: block; font-size: 11px; color: var(--text-muted); margin-bottom: 4px;\">中断回数閾値（回/日）</label>\n        <input type=\"number\" id=\"break-threshold\" value=\"5\" min=\"1\" max=\"20\" style=\"padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); color: var(--text); font-size: 13px; line-height: 1.4; width: 100%;\">\n      </div>\n      \n      <div style=\"margin-bottom: 10px;\">\n        <label style=\"display: block; font-size: 11px; color: var(--text-muted); margin-bottom: 4px;\">工数超過率（%）</label>\n        <input type=\"number\" id=\"hours-threshold\" value=\"150\" min=\"100\" max=\"300\" style=\"padding: 6px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); color: var(--text); font-size: 13px; line-height: 1.4; width: 100%;\">\n      </div>\n      \n      <button id=\"btn-save-rules\" class=\"action-btn secondary\" style=\"width: 100%; margin-top: 8px;\">設定保存</button>\n    </div>\n\n    <!-- 除外条件設定 -->\n    <div class=\"card\" style=\"margin-bottom: 12px; padding: 14px;\">\n      <h3 style=\"font-size: 13px; font-weight: 600; color: var(--text); margin: 0 0 10px 0;\">除外条件</h3>\n      \n      <div style=\"margin-bottom: 8px;\">\n        <label style=\"display: flex; align-items: center; font-size: 12px; color: var(--text);\">\n          <input type=\"checkbox\" id=\"exclude-weekend\" style=\"accent-color: var(--primary); margin-right: 6px;\">\n          土日を除外\n        </label>\n      </div>\n      \n      <div style=\"margin-bottom: 8px;\">\n        <label style=\"display: flex; align-items: center; font-size: 12px; color: var(--text);\">\n          <input type=\"checkbox\" id=\"exclude-holiday\" style=\"accent-color: var(--primary); margin-right: 6px;\">\n          祝日を除外\n        </label>\n      </div>\n      \n      <div style=\"margin-bottom: 10px;\">\n        <label style=\"display: flex; align-items: center; font-size: 12px; color: var(--text);\">\n          <input type=\"checkbox\" id=\"exclude-emergency\" style=\"accent-color: var(--primary); margin-right: 6px;\">\n          緊急作業を除外\n        </label>\n      </div>\n    </div>\n\n    <!-- 検出統計 -->\n    <div class=\"card\" style=\"padding: 14px;\">\n      <h3 style=\"font-size: 13px; font-weight: 600; color: var(--text); margin: 0 0 10px 0;\">検出統計</h3>\n      \n      <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;\">\n        <div style=\"text-align: center; padding: 8px; background: rgba(255,255,255,0.02); border-radius: 4px;\">\n          <div style=\"font-size: 18px; font-weight: 600; color: var(--primary);\" id=\"total-count\">0</div>\n          <div style=\"font-size: 11px; color: var(--text-muted);\">総検出数</div>\n        </div>\n        <div style=\"text-align: center; padding: 8px; background: rgba(255,255,255,0.02); border-radius: 4px;\">\n          <div style=\"font-size: 18px; font-weight: 600; color: #ff6a00;\" id=\"unconfirmed-count\">0</div>\n          <div style=\"font-size: 11px; color: var(--text-muted);\">未確認</div>\n        </div>\n      </div>\n      \n      <div style=\"margin-bottom: 8px;\">\n        <div style=\"display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted);\">\n          <span>高重要度</span>\n          <span id=\"high-count\">0</span>\n        </div>\n        <div style=\"display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted);\">\n          <span>中重要度</span>\n          <span id=\"medium-count\">0</span>\n        </div>\n        <div style=\"display: flex; justify-content: space-between; font-size: 11px; color: var(--text-muted);\">\n          <span>低重要度</span>\n          <span id=\"low-count\">0</span>\n        </div>\n      </div>\n      \n      <button onclick=\"window.showScreen('scr-1778907170814')\" class=\"action-btn secondary\" style=\"width: 100%; font-size: 12px;\">検出ログ詳細</button>\n    </div>\n  </div>\n</div>",
  "initJs": "function(container, apiUrl, tables) {}"
}